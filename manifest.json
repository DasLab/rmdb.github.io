---
layout: null
permalink: /manifest.json
---
[{% for e in site.entries %}
  {
    "rmdb_id":         {{ e.rmdb_id | jsonify }},
    "name":            {{ e.name | jsonify }},
    "category":        {{ e.category | jsonify }},
    "authors":         {{ e.citation.authors | jsonify }},
    "pub_title":       {{ e.citation.title | jsonify }},
    "pubmed":          {{ e.citation.pubmed | jsonify }},
    "doi":             {{ e.citation.doi | jsonify }},
    "date":            {{ e.date | date: "%Y-%m-%d" | jsonify }},
    "creation_date":   {{ e.creation_date | jsonify }},
    "construct_count": {{ e.construct_count | default: 0 }},
    "data_points":     {{ e.data_points | default: 0 }},
    "sequence_len":    {{ e.sequence | size }},
    "thumbnail":       {{ e.thumbnail | jsonify }},
    "url":             {{ e.url | jsonify }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}
]
